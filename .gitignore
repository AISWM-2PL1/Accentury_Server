# === 공통 (모든 파트) ===
.DS_Store
.env
.env.*
.omc/
.idea/
.vscode/
/build

# scripts/의 파이썬 (KAN-138 E2E 스모크) - ai/.gitignore와 같은 규칙이지만
# 여기는 레포 루트라 그쪽 파일이 닿지 않는다.
scripts/__pycache__/
__pycache__/

# === Terraform (KAN-140) ===
# state 파일에는 시크릿이 평문으로 들어갈 수 있다. 커밋 금지.
*.tfstate
*.tfstate.backup
.terraform/
# terraform plan -out 산출물. state처럼 리소스 값이 들어 있다.
*.tfplan
tfplan

# 콘텐츠 발행 도구의 중간 산출물 (tools/content) - 검수표 아티팩트용이라 레포에 두지 않는다
tools/content/__pycache__/
tools/content/vocabulary_review.json
